# .env.example
# Copy to .env.local (which is gitignored) for local development or set in deployment platform

# Optional: Precomputed SHA-256 hash of your CMS admin passphrase
# Generate with: node scripts/generate-password-hash.js "your-passphrase"
# If left empty, you will be prompted to initialize your passphrase securely on first visit in your browser.
VITE_ADMIN_PASSWORD_HASH=
